# Application Port
PORT=3000

# Environment
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/koa-db

# JWT Secrets
JWT_SECRET=super_secret_jwt_key_please_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_please_change_in_production
JWT_REFRESH_EXPIRES_IN=7d
